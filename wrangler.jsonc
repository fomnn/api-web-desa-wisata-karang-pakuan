{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "api-web-desa-wisata-karang-pakuan",
  "compatibility_date": "2026-11-18",
  "vars": {
    "CORS_ORIGINS": "",
    "MEDIA_BASE_URL": ""
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dev-web-desa-wisata-karang-pakuan",
      "database_id": "d3f9888a-bcda-4d05-86e1-b465149fdcfd"
    }
  ],
  "r2_buckets": [
    {
      "bucket_name": "dev-web-desa-wisata-karang-pakuan-storage",
      "binding": "STORAGE"
    }
  ],
  "env": {
    "staging": {
      "name": "api-web-desa-wisata-karang-pakuan-staging",
      "vars": {
        "CORS_ORIGINS": "",
        "MEDIA_BASE_URL": ""
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "web-desa-wisata-karang-pakuan-staging",
          "database_id": "86ac9d60-bcce-44b9-a5a6-156bc36bac51"
        }
      ],
      "r2_buckets": [
        {
          "bucket_name": "web-desa-wisata-karang-pakuan-staging-storage",
          "binding": "STORAGE"
        }
      ]
    }
  }
}
