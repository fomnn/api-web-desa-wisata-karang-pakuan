{
  "name": "api-web-desa-wisata-karang-pakuan",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "postinstall": "pnpm run env:local-d1",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "env:local-d1": "node .dev-scripts/sync-local-d1-env.mjs",
    "db:migrate:local": "pnpm run env:local-d1 && drizzle-kit migrate --config drizzle.local.config.ts",
    "db:push:local": "pnpm run env:local-d1 && drizzle-kit push --config drizzle.local.config.ts",
    "db:seed:local": "node .dev-scripts/seed-local.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.0",
    "@tanstack/react-router": "^1.170.46",
    "drizzle-orm": "1.0.0-rc.5",
    "nitro": "^3.0.261103-rc",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "1.0.0-rc.5",
    "miniflare": "^4.20260730.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "rolldown": "^1",
    "tailwindcss": "^4.3.5",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "typescript": "latest",
    "vite": "^8.3.8",
    "wrangler": "^4.163.0"
  }
}
