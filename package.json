{
  "name": "api-web-desa-wisata-karang-pakuan",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nitro dev",
    "build": "nitro build",
    "preview": "nitro preview",
    "postinstall": "pnpm run env:local-d1",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "env:local-d1": "node .dev-scripts/sync-local-d1-env.mjs",
    "db:migrate:local": "pnpm run env:local-d1 && drizzle-kit migrate --config drizzle.local.config.ts",
    "db:push:local": "pnpm run env:local-d1 && drizzle-kit push --config drizzle.local.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "1.0.0-rc.5",
    "nitro": "^3.0.261103-rc"
  },
  "devDependencies": {
    "@types/node": "latest",
    "drizzle-kit": "1.0.0-rc.5",
    "miniflare": "^4.20260730.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "rolldown": "^1",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "typescript": "latest",
    "wrangler": "^4.163.0"
  }
}